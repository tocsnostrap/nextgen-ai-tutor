# Copy this to .env and fill in your values. Never commit .env.

# Required for the tutor to answer. From https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Postgres. Railway provides this; postgresql:// is converted automatically.
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/ai_tutor

# Signs login tokens. Required when ENVIRONMENT=production. Any long random string.
SECRET_KEY=
ENVIRONMENT=development

# Claude models (defaults shown)
TUTOR_MODEL=claude-sonnet-5-5
FAST_MODEL=claude-haiku-5-5

# true turns on /docs and SQL logging. Development only.
DEBUG=false

# Comma-separated origins allowed to call the API from another site. Usually empty.
CORS_ORIGINS=
