# Copy this to .env and fill in your values

# Required — get from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Database (Render/Railway provides this automatically)
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/ai_tutor

# Auto-generated secrets (use any long random string)
SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET_KEY=change-me-to-another-long-random-string

# App settings
DEBUG=false
REDIS_ENABLED=false
